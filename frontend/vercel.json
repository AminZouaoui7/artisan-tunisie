{
  "redirects": [
    { "source": "/tunisian-rugs", "destination": "/en/tunisian-rugs", "permanent": true },
    { "source": "/tapis-tunisien", "destination": "/tapis-tunisiens", "permanent": true },
    { "source": "/tapis-berbere", "destination": "/tapis-berbere-tunisie", "permanent": true },
    { "source": "/tapis-laine", "destination": "/tapis-laine-tunisie", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/boutique", "destination": "/boutique.html" },
    { "source": "/our-story", "destination": "/our-story.html" },
    { "source": "/reservation", "destination": "/reservation.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/artisanat-de-la-tunisie", "destination": "/artisanat-de-la-tunisie.html" },
    { "source": "/tapis-tunisiens", "destination": "/tapis-tunisiens.html" },
    { "source": "/tapis-artisanal-tunisie", "destination": "/tapis-artisanal-tunisie.html" },
    { "source": "/tapis-berbere-tunisie", "destination": "/tapis-berbere-tunisie.html" },
    { "source": "/tapis-laine-tunisie", "destination": "/tapis-laine-tunisie.html" },
    { "source": "/margoum", "destination": "/margoum.html" },
    { "source": "/kilim", "destination": "/kilim.html" },
    { "source": "/tapis-noue", "destination": "/tapis-noue.html" },
    { "source": "/en/tunisian-rugs", "destination": "/en/tunisian-rugs.html" },
    { "source": "/en/handmade-rugs", "destination": "/en/handmade-rugs.html" },
    { "source": "/en/berber-rugs", "destination": "/en/berber-rugs.html" },
    { "source": "/en/kilim-rugs", "destination": "/en/kilim-rugs.html" },
    { "source": "/en/margoum-rugs", "destination": "/en/margoum-rugs.html" },
    { "source": "/products/:slug", "destination": "/products/:slug.html" },
    { "source": "/login", "destination": "/private.html" },
    { "source": "/register", "destination": "/private.html" },
    { "source": "/verify-email", "destination": "/private.html" },
    { "source": "/session-expired", "destination": "/private.html" },
    { "source": "/cart", "destination": "/private.html" },
    { "source": "/checkout", "destination": "/private.html" },
    { "source": "/account", "destination": "/private.html" },
    { "source": "/account/:path*", "destination": "/private.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
